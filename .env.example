# Activiity - Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================================================
# OPENROUTER (REQUIRED for target LLM + judge)
# ============================================================================
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# HUGGINGFACE (only if using HF embeddings or reranker)
# ============================================================================
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# LLM Configuration
# ============================================================================
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemma-4-31b-it


# ============================================================================
# Embeddings Configuration
# ============================================================================
EMBED_PROVIDER=hf
ST_EMBED_MODEL=ibm-granite/granite-embedding-311m-multilingual-r2



# ============================================================================
# Synthesis (Two-LLM split)
# ============================================================================
USE_HAIKU_SYNTH=1
HAIKU_MODEL=anthropic/claude-haiku-4-5

# ============================================================================
# Qdrant
# ============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=activiity_kb

# ============================================================================
# Data directories
# ============================================================================
ACTIVIITY_DATA_DIR=data

# ============================================================================
# Agentic RAG v3 — Architecture improvements
# ============================================================================

# Structure-aware splitter: chunk on Fiche Protocole markers (principles, etc.)
# 1 = ON (recommended), 0 = OFF (fallback to sentence splitter)
USE_STRUCTURE_SPLITTER=1

# Context compression: filter retrieved nodes to keep only relevant sentences
# before synthesis. Reduces noise, improves faithfulness.
# 1 = ON (recommended), 0 = OFF
USE_CONTEXT_COMPRESSION=1

# Max agent iterations (ReAct loop): 1 initial tool call + up to 3 retries
# (relance query_global when query_by_ua is empty) + final "Answer:" step.
AGENT_MAX_ITER=8

# Reranker (optional — improves context precision)
USE_RERANKER=0
RERANKER_PROVIDER=openrouter
RERANKER_MODEL=cohere/rerank-4-fast
RERANK_TOP_K=20
RERANK_KEEP=8

# Top-k retrieval
TOP_K_PER_UA=5
TOP_K_GLOBAL=8